// ============================================================
// 抽選申込
//
// 先着形式の場合は作られない
// ============================================================

model LotteryApplication {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId       String
  saleWindowId String

  paymentMethod  PaymentMethod // 希望している決済方式
  capturedAmount Int // キャプチャした額

  user       User       @relation(fields: [userId], references: [id])
  saleWindow SaleWindow @relation(fields: [saleWindowId], references: [id])

  lotteryApplicationItems LotteryApplicationItem[]
}

model LotteryApplicationItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  applicationId   String
  saleOfferRateId String
  orderItemId     String? @unique // 当選して取引データが作られたら値が入る

  preferenceRank Int // 第1希望→1 第2希望→2 第3希望→3
  quantity       Int
  lotteryResult  LotteryResult @default(PENDING)

  lotteryApplication LotteryApplication @relation(fields: [applicationId], references: [id])
  saleOfferRate      SaleOfferRate      @relation(fields: [saleOfferRateId], references: [id])
  orderItem          OrderItem?         @relation(fields: [orderItemId], references: [id])

  @@unique([applicationId, preferenceRank])
}

enum LotteryResult {
  PENDING // 当落を出してない
  WON // 当選
  LOST // 落選
}
