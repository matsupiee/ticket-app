// プラットフォーム運営者（ticket-app 自身の運営メンバー）を管理するテーブル
// プラットフォーム管理画面・platform.* APIの認可は、このテーブルの有無だけを正とする
// フロントのビルド時定数やメールアドレスの許可リストで判定しない
// 主催者側の OrganizerMember と同じ考え方で、ユーザーとロールをDBで持つ
model PlatformMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId String             @unique // 1ユーザーにつき1レコード
  role   PlatformMemberRole

  user User @relation(fields: [userId], references: [id])
}

// VIEWER / EDITOR は OrganizerMemberRole と同じ意味で使う
enum PlatformMemberRole {
  VIEWER // 閲覧だけ
  EDITOR // 主催者の審査・状態変更など編集可能
  OWNER // 編集に加えて、運営メンバーの追加・削除が可能
}
