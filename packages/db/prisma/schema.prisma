generator client {
  provider        = "prisma-client"
  runtime         = "nodejs"
  output          = "../src/generated/prisma"
  // partialIndexes: @@unique の where 句（部分インデックス）。
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// イベント・公演
// ============================================================

model Event {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  organizerId String

  name        String
  description String // 何もない場合は空文字

  organizer Organizer @relation(fields: [organizerId], references: [id])

  stages           Stage[]
  saleWindows      SaleWindow[]
  seatCategories   TicketCategory[]
  rateTypes        RateType[]
  voucherTemplates VoucherTemplate[]
  feeRules         FeeRule[]
}

model Stage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  eventId String
  venueId String

  // 指定席がある公演の場合は座席レイアウトを紐づける
  // 指定席がない場合はnull
  // 公演によっては、一部は自由席で一部は指定席というパターンもあるので注意
  //　また、指定席の場合でも未設定段階ではnull
  // 複数公演で同じ座席レイアウトを使うことがあるので、Stage:SeatLayout=N:1
  seatLayoutId String?

  name        String
  doorsOpenAt DateTime // 開場時間
  startsAt    DateTime // 開始時間

  event      Event       @relation(fields: [eventId], references: [id])
  venue      Venue       @relation(fields: [venueId], references: [id])
  seatLayout SeatLayout? @relation(fields: [seatLayoutId], references: [id])

  inventoryPools     InventoryPool[]
  ticketEntitlements TicketEntitlement[]
  stageArtists       StageArtist[]
}

model Artist {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name         String
  imageUrl     String?
  stageArtists StageArtist[]
}

model StageArtist {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  stageId  String
  artistId String

  stage  Stage  @relation(fields: [stageId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])
}

model Venue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name String

  seatLayouts SeatLayout[]
  stages      Stage[]
}

// ============================================================
// チケット種別
//
// ツアーや複数公演で同じ席種を共有するため、席種はEvent配下に置く。
//
// 例: S席, A席, VIP席, 一般席 などなど
// ============================================================

model TicketCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  eventId String

  kind         TicketCategoryKind
  name         String
  description  String // 何もない場合は空文字
  displayOrder Int                @default(0)

  event Event @relation(fields: [eventId], references: [id])

  inventoryPools InventoryPool[]

  @@unique([eventId, name])
}

enum TicketCategoryKind {
  ENTRY_NUMBER // 整理番号
  RESERVED_SEAT // 指定席
}

// ============================================================
// 料金種別
//
// 大人・子供などの料金区分。
// 実際の価格は SaleWindow(販売受付)や SaleOffer(商品)によって変動するので、
// このテーブルでは持たずに SaleOfferRate に保持する。
//
// ※ なぜ `rate` という命名にするのか？
// `rate`は「条件や区分に応じて適用される料金」というニュアンスを持つため
// `price`は具体的な金額の違いを表す。例: S席=10000円 A席=5000円 の違い
// ============================================================

model RateType {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  eventId String

  name         String
  displayOrder Int    @default(0)

  event Event @relation(fields: [eventId], references: [id])

  saleOfferRates SaleOfferRate[]

  @@unique([eventId, name])
}

// ============================================================
// 販売受付
//
// 例1: 単独公演(SaleOfferEntitlementが1つだけ)
// 一般販売（SaleWindow）
// ├─ S席（SaleOffer）
// │  ├─ 大人・子供 100円（SaleOfferRate）
// │  └─ 公演1・S席在庫への利用権（SaleOfferEntitlement）
// │     └─ 公演1 S席在庫（InventoryPool）
// │        ├─ S席 座席1（InventorySlot）
// │        ├─ S席 座席2（InventorySlot）
// │        └─ ...
// └─ A席（SaleOffer）
//    ├─ 大人・子供 30円（SaleOfferRate）
//    └─ 公演1・A席在庫への利用権（SaleOfferEntitlement）
//       └─ 公演1 A席在庫（InventoryPool）
//          ├─ A席 座席1（InventorySlot）
//          ├─ A席 座席2（InventorySlot）
//          └─ ...
// 先行販売（SaleWindow）
// ├─ S席（SaleOffer）
// │  ├─ 大人・子供 100円（SaleOfferRate）
// │  └─ 公演1・S席在庫への利用権（SaleOfferEntitlement）
// │     └─ 公演1 S席在庫（InventoryPool）
// │        ├─ S席 座席1（InventorySlot）
// │        ├─ S席 座席2（InventorySlot）
// │        └─ ...
// └─ A席（SaleOffer）
//    ├─ 大人・子供 30円（SaleOfferRate）
//    └─ 公演1・A席在庫への利用権（SaleOfferEntitlement）
//       └─ 公演1 A席在庫（InventoryPool）
//          ├─ A席 座席1（InventorySlot）
//          ├─ A席 座席2（InventorySlot）
//          └─ ...
//
// 例2: 単独公演 + 料金種別あり
// 一般販売（SaleWindow）
// ├─ S席（SaleOffer）
// │  ├─ 大人 100円（SaleOfferRate）
// │  ├─ 学生 60円（SaleOfferRate）
// │  ├─ 子供 30円（SaleOfferRate）
// │  └─ 公演1・S席在庫への利用権（SaleOfferEntitlement）
// │     └─ 公演1 S席在庫（InventoryPool）
// │        ├─ S席 座席1（InventorySlot）
// │        ├─ S席 座席2（InventorySlot）
// │        └─ ...
// │
// └─ A席（SaleOffer）
//    ├─ 大人 50円（SaleOfferRate）
//    ├─ 学生 30円（SaleOfferRate）
//    ├─ 子供 20円（SaleOfferRate）
//    └─ 公演1・A席在庫への利用権（SaleOfferEntitlement）
//       └─ 公演1 A席在庫（InventoryPool）
//          ├─ A席 座席1（InventorySlot）
//          ├─ A席 座席2（InventorySlot）
//          └─ ...
//
// 例3: 通し券
// 一般販売（SaleWindow）
// ├─ 2日通し券 S席（SaleOffer）
// │  ├─ 大人・子供 180円（SaleOfferRate）
// │  ├─ 公演1・S席在庫への利用権（SaleOfferEntitlement）
// │  │  └─ 公演1 S席在庫（InventoryPool）
// │  │     ├─ 公演1 S席 座席1（InventorySlot）
// │  │     ├─ 公演1 S席 座席2（InventorySlot）
// │  │     └─ ...
// │  └─ 公演2・S席在庫への利用権（SaleOfferEntitlement）
// │     └─ 公演2 S席在庫（InventoryPool）
// │        ├─ 公演2 S席 座席1（InventorySlot）
// │        ├─ 公演2 S席 座席2（InventorySlot）
// │        └─ ...
// │
// └─ 2日通し券 A席（SaleOffer）
//    ├─ 大人・子供 90円（SaleOfferRate）
//    ├─ 公演1・A席在庫への利用権（SaleOfferEntitlement）
//    │  └─ 公演1 A席在庫（InventoryPool）
//    │     ├─ 公演1 A席 座席1（InventorySlot）
//    │     ├─ 公演1 A席 座席2（InventorySlot）
//    │     └─ ...
//    └─ 公演2・A席在庫への利用権（SaleOfferEntitlement）
//       └─ 公演2 A席在庫（InventoryPool）
//          ├─ 公演2 A席 座席1（InventorySlot）
//          ├─ 公演2 A席 座席2（InventorySlot）
//          └─ ...
// ============================================================

model SaleWindow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  eventId String

  name String

  publishesAt         DateTime? // 公開日時
  applicationStartsAt DateTime // 申し込み開始日時
  applicationEndsAt   DateTime // 申し込み終了日時

  canceledAt   DateTime? // キャンセルした際に値が入る
  cancelReason String? // キャンセルした際に値が入る

  isSmsAuthRequired Boolean // 電話番号認証が必要かどうか？

  saleMethod SaleMethod // 販売方式

  // 販売方式が抽選の場合は、以下のカラムに値が入る
  autoLotteryStartsAt     DateTime? // 自動抽選を開始する日時（手動抽選の場合は不要）
  notifiesLotteryResultAt DateTime? // 抽選結果をユーザーに伝える日時
  maxLotteryItemCount     Int? // 第何希望まで申し込めるか？

  event Event @relation(fields: [eventId], references: [id])

  saleOffers   SaleOffer[]
  applications Application[]
  feeRules     FeeRule[]
}

enum SaleMethod {
  FIRST_COME // 先着
  LOTTERY // 抽選
}

// ============================================================
// 販売商品
//
// SaleWindow（先行販売・一般販売など）の中で、ユーザーが実際に選択・購入する商品を表す。
//
// 例: 2日間の公演があり、S席・A席があり、先行販売・一般販売がある場合
// - 先行販売(SaleWindow)
//   - S席 公演1日目（SaleOffer)
//   - S席 公演2日目（SaleOffer)
//   - S席 2日通し券（SaleOffer)
//   - A席 公演1日目（SaleOffer)
//   - A席 公演1日目（SaleOffer)
//   - A席 2日通し券（SaleOffer)
// - 一般販売(SaleWindow)
//   - S席 公演1日目（SaleOffer)
//   - S席 公演2日目（SaleOffer)
//   - S席 2日通し券（SaleOffer)
//   - A席 公演1日目（SaleOffer)
//   - A席 公演1日目（SaleOffer)
//   - A席 2日通し券（SaleOffer)
// ============================================================

model SaleOffer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  saleWindowId String

  // 基本的に TicketCategory.name がコピーされる
  // 通し券などの場合は上書きされる
  name        String
  description String // 何もない場合は空文字

  maxQuantityPerOrder Int @default(4)
  // 「この商品は2枚単位でしか買えない」というような制約をつけたい場合に使う
  quantityStep        Int @default(1)
  displayOrder        Int @default(0)

  saleWindow SaleWindow @relation(fields: [saleWindowId], references: [id])

  saleOfferRates        SaleOfferRate[] // 料金種別がある場合は2つ以上、ない場合は1つだけ紐づく
  saleOfferEntitlements SaleOfferEntitlement[] // 通し券の場合は2つ以上、その他は1つだけ紐づく
  saleOfferVouchers     SaleOfferVoucher[]
  feeRules              FeeRule[]
}

model SaleOfferRate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  saleOfferId String
  rateTypeId  String

  price Int

  saleOffer SaleOffer @relation(fields: [saleOfferId], references: [id])
  rateType  RateType  @relation(fields: [rateTypeId], references: [id])

  applicationItems ApplicationItem[]

  @@unique([saleOfferId, rateTypeId])
}

// ============================================================
// 手数料設定ルール
// ============================================================

model FeeRule {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // eventId は所属 Event を表す
  // saleWindowId / saleOfferId が NULL の場合は
  // Event 全体の手数料として扱い、saleWindowId がある場合は販売受付単位、
  // saleOfferId がある場合は販売商品単位の手数料として扱う。
  // ただし、「saleWindowId と saleOfferId が両方設定される」「saleOfferId が別イベントに属している」
  // というような不整合が起きないように気をつける必要がある
  eventId      String
  saleWindowId String?
  saleOfferId  String?

  displayOrder    Int      @default(0)
  name            String
  payer           FeePayer
  // 例1: 5% → rateBasisPoints=500, flatAmount=0
  // 例2: 300円 → rateBasisPoints=0, flatAmount=300
  // 例3: 3% + 100円  → rateBasisPoints=300, flatAmount=100
  rateBasisPoints Int // 割合
  flatAmount      Int // 固定額

  // 最初は切り下げで固定する
  // roundingMode    FeeRoundingMode // 切り上げ / 切り下げ / 四捨五入

  // 以下のような設定をすることも考えられるが最初は必要性が低い
  // 一旦は、1チケットごとに発生する前提にする
  // - PER_TICKET: 1チケットごと
  // - PER_ORDER: 1注文ごと（注文枚数が1枚でも4枚でも変わらない）

  event      Event       @relation(fields: [eventId], references: [id])
  saleWindow SaleWindow? @relation(fields: [saleWindowId], references: [id])
  saleOffer  SaleOffer?  @relation(fields: [saleOfferId], references: [id])

  applicationItemFees ApplicationItemFee[]
}

enum FeePayer {
  // 購入者が負担する
  // 購入者の支払総額に加算される
  // チケット購入画面上に表示される
  BUYER
  // イベント主催者が負担する
  // 購入者の支払総額には影響しない。主催者の精算額から差し引く
  // チケット購入画面には表示されない
  EVENT_ORGANIZER
}

// ============================================================
// 販売商品が付与する公演利用権
//
// Entitlement=利用権
//
// 通常券では 1 saleOffer に対して1件。
// 通し券では 1 saleOffer に対して複数件。
// ============================================================

model SaleOfferEntitlement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  saleOfferId     String
  inventoryPoolId String

  saleOffer SaleOffer @relation(fields: [saleOfferId], references: [id])

  inventoryPool InventoryPool @relation(fields: [inventoryPoolId], references: [id])
}

// ============================================================
// 在庫
//
// InventoryPool: 公演 x 席種に対して 1 レコード作成される
// InventorySlot: 販売・確保・発券で消費される最小単位。指定席でも整理番号でも、発券時には必ず1つのInventorySlotを消費する。
// ============================================================

model InventoryPool {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  stageId          String
  ticketCategoryId String

  // 以下の2つは表示用のキャッシュ値（正しい値は inventorySlot を数える必要がある）
  capacity  Int
  heldCount Int @default(0)

  // 次に払い出す整理番号。Order への割り当て時に UPDATE ... RETURNING で atomic に採番する
  // max(entryNumber) + 1 を読んでから書く方式は同時申込で衝突するため使わない
  // キャンセルで空いた番号は再利用しないので、この値は減らさない
  nextEntryNumber Int @default(1)

  stage          Stage          @relation(fields: [stageId], references: [id])
  ticketCategory TicketCategory @relation(fields: [ticketCategoryId], references: [id])

  inventorySlots        InventorySlot[]
  saleOfferEntitlements SaleOfferEntitlement[]

  @@unique([stageId, ticketCategoryId])
}

model InventorySlot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  inventoryPoolId String // 1 inventorySlot は 1inventoryPool にのみ所属できるようにする
  // 指定席方式の場合だけ値が入る。
  // 座席は「この在庫枠が会場のどの席か」という在庫側の事実である
  // 確保(HELD)した時点で確定していないと「A列12番を確保中」を表現できない
  // そのため、ここで持つ必要がある
  seatId          String?

  // 割り振られた整理番号（整理番号方式の場合だけ値が入る）
  // Order にこの枠を割り当てる時点で採番する
  // 先着販売においては、発券時ではなく申込時に採番する（発券時だとコンビニ払い時に後ろの番号が採番されてしまう）
  // Order キャンセル時は null に戻る。その番号は再利用されず、欠番になる
  entryNumber Int?

  status InventorySlotStatus @default(AVAILABLE)

  inventoryPool InventoryPool @relation(fields: [inventoryPoolId], references: [id])
  seat          Seat?         @relation(fields: [seatId], references: [id])

  slotHold           InventorySlotHold?
  ticketEntitlements TicketEntitlement[]

  @@unique([inventoryPoolId, seatId]) // 同じ座席に対する在庫枠が二重に作られないようにする
  @@unique([inventoryPoolId, entryNumber]) // 同じ公演 x 席種で整理番号が重複しないようにする
  @@index([inventoryPoolId, status]) // 先着販売で AVAILABLE な枠を探しやすくするためのインデックス
}

enum InventorySlotStatus {
  AVAILABLE // 販売可能
  HELD // 確保中
  VOIDED // 無効化された
}

// ============================================================
// 在庫枠の確保
//
// 「どの申し込みがこの在庫枠を押さえているか」を表す。
// InventorySlot.status = HELD の枠には必ず1件存在し、解放時は行ごと削除して
// InventorySlot.status を AVAILABLE に戻す。
//
// 発券後もこの行は残る。発券は TicketEntitlement が増えるだけで、
// 「枠が埋まった」という事実の正本は常にこのテーブルが担う
// ============================================================

model InventorySlotHold {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // 1つの在庫枠を同時に複数の申し込みが確保できないようにする
  inventorySlotId   String @unique
  // どの申し込みが確保しているか
  // 抽選は当選確定時に対応する ApplicationItem.lotteryResult が WON になり Order が作られるため、
  // 先着・抽選のどちらも ApplicationItem から Application → Order を辿れば申込元・注文の両方に到達できる
  applicationItemId String

  // 自動解放期限はカラムとして設ける必要はないと判断した
  // カード決済時の仮確保期間: 計算で導き出せる
  // コンビニ払いの支払期限： 計算で導き出せる
  // expiresAt DateTime?

  inventorySlot   InventorySlot   @relation(fields: [inventorySlotId], references: [id])
  applicationItem ApplicationItem @relation(fields: [applicationItemId], references: [id])
}

// ============================================================
// 申込
// ============================================================

//      Application
//      /           \
// FIRST_COME     LOTTERY
// │                 │
// │              抽選結果
// │             /       \
// │          LOST       WON
// │                      │
// └──────────┬───────────┘
//            ↓
//          Order
//            ↓
//         Payment

model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId       String
  saleWindowId String

  paymentMethod PaymentMethod

  user       User       @relation(fields: [userId], references: [id])
  saleWindow SaleWindow @relation(fields: [saleWindowId], references: [id])

  applicationItems                ApplicationItem[]
  applicationPaymentAuthorization ApplicationPaymentAuthorization?
  order                           Order?
}

model ApplicationItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  applicationId   String
  saleOfferRateId String

  unitPrice      Int
  quantity       Int
  preferenceRank Int // 第1希望→1 第2希望→2 第3希望→3
  lotteryResult  LotteryResult?

  application   Application   @relation(fields: [applicationId], references: [id])
  saleOfferRate SaleOfferRate @relation(fields: [saleOfferRateId], references: [id])

  applicationItemFees ApplicationItemFee[]
  inventorySlotHolds  InventorySlotHold[]
  refundItems         RefundItem[]
  tickets             Ticket[]

  @@unique([applicationId, preferenceRank])
}

enum LotteryResult {
  PENDING // 当落を出してない
  WON // 当選
  LOST // 落選
}

// ============================================================
// saleOfferごとに表示される手数料
// 申込時に画面上に表示される手数料
//
// 申込後に FeeRule が変更されても購入者請求・主催者精算・返金判断を
// 監査できるように、計算条件と計算結果をスナップショットとして保持する。
// ============================================================

model ApplicationItemFee {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  applicationItemId String
  feeRuleId         String

  // 以下のカラムは FeeRule からそのままコピーした値を入れる
  displayOrder    Int
  name            String
  payer           FeePayer
  rateBasisPoints Int
  flatAmount      Int

  // 実際に計算された額も保存しておく（丸め処理や計算仕様変が更時した際に困らないようにするため）
  amount Int

  applicationItem ApplicationItem @relation(fields: [applicationItemId], references: [id])
  feeRule         FeeRule         @relation(fields: [feeRuleId], references: [id])
}

// 与信枠確保
// 抽選の場合だけ記録される
//
// 通常抽選の場合
// - 第1希望 20,000 円
// - 当落を出した際に 20,000 円を Capture
// 希望制抽選の場合
// - 第1希望 20,000 円 第2希望 15,000 円 第3希望 10,000 円 → 20,000 円を与信確保
// - 当落を出した際に必要な金額だけを Capture する。不要分は返金
model ApplicationPaymentAuthorization {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId String @unique

  provider          PaymentProvider
  providerPaymentId String
  authorizedAmount  Int // 与信枠として確保された金額
  releasedAt        DateTime? // いつ与信が解放されたか？

  application Application @relation(fields: [applicationId], references: [id])
}

// ============================================================
// 注文
//
// 「購入する内容が確定し、販売側が注文として受け付けたもの」を表す
//
// 先着: application と applicationItem 作成時点で注文が成立
// 抽選: application と applicationItem 作成時点で注文が成立しない
// ============================================================

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId        String
  applicationId String @unique

  status         OrderStatus
  subtotalAmount Int // 手数料を除いた価格部分の合計
  totalFeeAmount Int // 手数料の合計
  totalAmount    Int // 価格部分の合計 + 手数料の合計

  user        User        @relation(fields: [userId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])

  payments Payment[]
  refunds  Refund[]
}

enum OrderStatus {
  PAYMENT_PROCESSING // 決済処理中
  COMPLETED // 完了
  CANCELED // キャンセル
}

// order : payment = 1 : N
// 決済が1回失敗して再試行したら成功したという場合は、1 order に対して 複数 payment が作成される
// 0円チケットの場合は payment が作成されない
model Payment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  applicationId String

  paymentMethod     PaymentMethod
  provider          PaymentProvider
  providerPaymentId String
  // 実際に支払う金額
  // 基本的に order.totalAmount と一緒になる
  // クーポンやポイントなどで割引が入ると order.totalAmount から割引分を引いた値が入る
  paymentAmount     Int
  succeededAt       DateTime?
  failedAt          DateTime?

  order   Order    @relation(fields: [applicationId], references: [id])
  refunds Refund[]

  @@unique([provider, providerPaymentId])
}

enum PaymentMethod {
  CARD
  KONBINI
}

enum PaymentProvider {
  STRIPE
}

// ユーザー都合で返金はできない
// 主催者の都合で払い戻しを行うことが可能
model Refund {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  orderId   String @unique
  paymentId String @unique

  providerRefundId String @unique // 決済プロバイダーが発行する返金ID

  amount                  Int // 合計返金額
  reason                  String
  completedAt             DateTime?
  bankAccount             Json? // コンビニ決済の場合は銀行振込で返金する
  bankAccountRegisteredAt DateTime? // 銀行振込返金の場合に記録される（記録された日から3営業日以内に振り込む必要がある）

  payment Payment @relation(fields: [paymentId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  refundItems RefundItem[]
}

model RefundItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  refundId          String
  applicationItemId String

  quantity Int // データモデル自体は部分返金に対応できる設計にしておく。4枚購入中2枚だけ返金するということを可能にしておく

  refund          Refund          @relation(fields: [refundId], references: [id])
  applicationItem ApplicationItem @relation(fields: [applicationItemId], references: [id])

  @@unique([refundId, applicationItemId])
}

// ============================================================
// 発券済みチケット
// ============================================================

model Ticket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  applicationItemId String
  ownerUserId       String // 所有者のID（チケットは分配されることがあるため）

  applicationItem ApplicationItem @relation(fields: [applicationItemId], references: [id])
  owner           User            @relation(fields: [ownerUserId], references: [id])

  ticketEntitlements TicketEntitlement[]
  ticketVouchers     TicketVoucher[]

  @@index([applicationItemId])
}

// ============================================================
// チケットの公演利用権
//
// 通常券なら1件。
// 通し券なら公演数分作成される。
// ============================================================

model TicketEntitlement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  ticketId        String
  // ある在庫枠を複数人が同時に所有しているのはおかしいので unique を張りたい
  // しかし、キャンセルされたレコードは履歴として残すため、素の @unique では枠を占有し続けてしまう。
  // そのため canceledAt が null の行だけを対象にした部分 unique index にしている
  inventorySlotId String
  // どの公演で使えるか？
  // inventorySlot → inventoryPool → stage で辿れるがパフォーマンス向上のために保持しておく
  stageId         String

  usedAt     DateTime?
  // キャンセル済みの場合に値が入る。行自体は履歴として残す。
  // 値が入るとき、対応する InventorySlot は AVAILABLE に戻っていなければならない。
  canceledAt DateTime?

  ticket        Ticket        @relation(fields: [ticketId], references: [id])
  inventorySlot InventorySlot @relation(fields: [inventorySlotId], references: [id])
  stage         Stage         @relation(fields: [stageId], references: [id])

  @@unique([ticketId, stageId])
  // 1つの在庫枠を同時に複数人が所有できないようにする。
  // キャンセル済みの行は対象外なので、キャンセル後はその枠を再販できる。
  @@unique([inventorySlotId], where: { canceledAt: null })
}

// ============================================================
// 発行済み副券
// ============================================================

model TicketVoucher {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  ticketId String

  name   String
  usedAt DateTime

  ticket Ticket @relation(fields: [ticketId], references: [id])
}
